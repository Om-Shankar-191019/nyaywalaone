# ---------------------------------------------------------------------------
# Nyaywala backend environment
# Copy to backend/.env and fill in. Every value below is explained in
# ../CREDENTIALS-NEEDED.md at the project root.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Postgres. Neon gives you TWO strings: the "-pooler" one and the direct one.
# DATABASE_URL  = pooled   (runtime queries, through the pg driver adapter)
# DIRECT_URL    = direct   (migrations only; pgbouncer cannot run migrations)
# Prisma 7: these live here and in prisma.config.ts - NOT in schema.prisma,
# which no longer carries a url.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/nyaywala?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/nyaywala?sslmode=require"

# Test database (same Neon project, separate database, e.g. nyaywala_test).
# REQUIRED in practice: `npm test` TRUNCATES every table between tests, so it
# must never point at your demo data. Create it with:
#   node scripts/setup-test-db.js   (then: npx prisma migrate deploy)
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""

# 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Browser origin of the frontend. Cookies are scoped to this origin.
APP_ORIGIN=http://localhost:5173
# Extra allowed origins, comma separated (e.g. the Vercel preview URL).
EXTRA_ALLOWED_ORIGINS=

# When set, registering as an instructor requires this exact code.
# Leave empty to allow open instructor signup (not recommended in production).
INSTRUCTOR_SIGNUP_CODE=change-me-before-demo

# Execution sandbox. judge0 | wandbox
EXECUTION_PROVIDER=judge0
JUDGE0_BASE_URL=https://ce.judge0.com
# Only needed if you move to a keyed RapidAPI Judge0 plan.
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_LANGUAGE_ID=103
# Calls per UTC day. The API returns 429 once the budget is spent.
JUDGE0_DAILY_BUDGET=200

# Optional C fallback. Note the "-c" suffix: Wandbox's plain "gcc-head" is C++.
WANDBOX_BASE_URL=https://wandbox.org
WANDBOX_COMPILER=gcc-head-c

# Day 6 dev-only smoke route. Set to false before the final deployment.
EXEC_SMOKE_ENABLED=true

# --- Week 2: grading engine ------------------------------------------------

# Optional LLM metric (llm_review). Without a key the metric is reported as
# "unavailable" and the rule set's on_unavailable policy decides the score -
# the evaluation still succeeds. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Analyzers dispatched together while grading (1-8). 3 suits a 3-concurrency
# provider budget; the coordinator's internal cap is 4 per evaluation.
GRADING_CONCURRENCY=3

# Shared secret for POST /api/internal/drain. The endpoint returns 404 while
# this is empty. Send it as the X-Cron-Secret header.
CRON_SECRET=
