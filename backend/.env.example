# ---------------------------------------------------------------------------
# Nyaywala backend environment
# Copy to backend/.env and fill in. Every value below is explained in
# ../CREDENTIALS-NEEDED.md at the project root.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Postgres. Neon gives you TWO strings: the "-pooler" one and the direct one.
# DATABASE_URL  = pooled   (runtime queries, through the pg driver adapter)
# DIRECT_URL    = direct   (migrations only; pgbouncer cannot run migrations)
# Prisma 7: these live here and in prisma.config.ts - NOT in schema.prisma,
# which no longer carries a url.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/nyaywala?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/nyaywala?sslmode=require"

# How the app reaches Neon. Leave this out (or `tcp`) normally: Postgres on 5432.
# Set `https` only if `npm run db:check` says port 5432 is blocked while 443
# works - campuses, hostels and some offices drop outbound 5432. The app then
# uses Neon's serverless driver over TLS on 443. Everything else is identical,
# including `npm run db:seed`. Migrations still need 5432 (they use DIRECT_URL).
# DATABASE_TRANSPORT=https

# Test database (same Neon project, separate database, e.g. nyaywala_test).
# REQUIRED in practice: `npm test` TRUNCATES every table between tests, so it
# must never point at your demo data. Create it with:
#   node scripts/setup-test-db.js   (then: npx prisma migrate deploy)
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""

# 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Browser origin of the frontend. Cookies are scoped to this origin.
# A request whose Origin equals the host it arrived on is always accepted, so a
# Vercel deployment works without editing this (see docs/vercel.md). Set it to
# the deployed URL anyway: it is the canonical value the browser is sent to.
APP_ORIGIN=http://localhost:5173
# Extra allowed origins, comma separated - needed only when the API is served
# from a different host than the page (e.g. a separate api.example.com).
EXTRA_ALLOWED_ORIGINS=

# When set, registering as an instructor requires this exact code.
# Leave empty to allow open instructor signup (not recommended in production).
INSTRUCTOR_SIGNUP_CODE=change-me-before-demo

# --- Week 3: execution sandbox ---------------------------------------------
# onlinecompiler | judge0 | wandbox
# onlinecompiler.io is the default: no credit card, one synchronous call, gcc 15.
EXECUTION_PROVIDER=onlinecompiler
ONLINECOMPILER_BASE_URL=https://api.onlinecompiler.io
# Required. Sign in at https://www.onlinecompiler.io/ and copy the API key.
# `JUDGE0_API_KEY` is accepted as a fallback name for this same value, so an
# older .env keeps working after the provider swap.
ONLINECOMPILER_API_KEY=
# Compiler id, not a language name: gcc-15 is the C toolchain.
ONLINECOMPILER_COMPILER=gcc-15
# Abort before the provider's own 30 s ceiling (5-35).
ONLINECOMPILER_TIMEOUT_SECONDS=25

# Calls per UTC day, whichever provider is configured. The API returns 429 once
# the budget is spent. JUDGE0_DAILY_BUDGET is accepted as a fallback name.
EXEC_DAILY_BUDGET=200

# Judge0 stays as an alternative, not the default. The public host needs no key.
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_LANGUAGE_ID=103

# Last-resort fallback. Note the "-c" suffix: Wandbox's plain "gcc-head" is C++.
WANDBOX_BASE_URL=https://wandbox.org
WANDBOX_COMPILER=gcc-head-c

# Day 6 dev-only smoke route. Set to false before the final deployment.
EXEC_SMOKE_ENABLED=true

# --- Week 2: grading engine ------------------------------------------------

# Optional language-model checks: feedback, readability, originality and
# compile-error recovery. See docs/llm.md. Without a key they are reported as
# "unavailable" (shown as "not run") and the grade is unaffected.
# One key is enough; providers are tried in LLM_PROVIDER_ORDER.
LLM_ENABLED=true
LLM_PROVIDER_ORDER=groq,gemini,openrouter,cerebras,mistral
LLM_TIMEOUT_MS=20000

# Groq (free, no card): https://console.groq.com/keys
# gpt-oss-20b is current on free keys; llama-3.3-70b-versatile returns 404 on
# new accounts, which used to surface as `llm_review: error` on every report.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Optional extra free providers, any one of them works on its own.
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter (use a ":free" model): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Check what actually answers from this machine (one tiny call per provider):
#   npm run llm:check

# Analyzers dispatched together while grading (1-8). 3 suits a 3-concurrency
# provider budget; the coordinator's internal cap is 4 per evaluation.
GRADING_CONCURRENCY=3

# Similarity: the originality scan compares submissions in one assignment.
# See the batch scan route in the README; no separate key is required.

# Shared secret for POST /api/internal/drain. The endpoint returns 404 while
# this is empty. Send it as the X-Cron-Secret header.
CRON_SECRET=
