{
  "name": "nyaywala-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "golden": "node scripts/golden.js",
    "verify-report": "node scripts/verify-report.js",
    "load-check": "node scripts/load-check.js",
    "exec:taxonomy": "node scripts/exec-taxonomy.js",
    "exec:smoke": "node scripts/smoke.js",
    "exec:check": "node scripts/provider-check.js",
    "db:setup-test": "node scripts/setup-test-db.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "web-tree-sitter": "^0.24.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "tree-sitter-wasms": "^0.1.11"
  }
}
